# ---- Gradle / 构建产物 ----
/.gradle/
/build/
/app/build/
/.kotlin/

# ---- IDE 本地状态（可共享的工程配置仍保留入库）----
/.idea/caches/
/.idea/codeStyles/
/.idea/workspace.xml
/.idea/shelf/
# IDE 插件生成的设置（Markdown 预览面板选择），不跟踪
/.idea/markdown.xml
# 设备选择/设备管理是本机状态，随模拟器使用反复变动
/.idea/deploymentTargetSelector.xml
/.idea/deviceManager.xml
*.iml

# ---- 本机配置（含 SDK 绝对路径，各人不同）----
local.properties

# ---- 签名密钥与口令，绝不能入库 ----
keystore.properties
*.jks
*.keystore

# ---- AI 助手的工作笔记（含本地路径等个人信息），公开仓库不入库 ----
/.workbuddy-ai/
# 其他 AI 工具的本地状态（会话计划文件等）
/.zcode/

# ---- 已发布的 APK 归档：不入库 ----
# APK 走 GitHub Releases 分发（.github/workflows/release.yml），不再随仓库增长。
# 本目录只剩本地留档作用（release.sh 会把产物复制到这里），CI 上不存在。
/app/release/
# 兜底：APK 一律不入库（曾有 3 个误入库进了历史），别只靠上面的目录规则
*.apk
