<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 应用内更新的安装包由 DownloadManager 后台拉取：不想要系统通知栏的常驻「正在下载」，
         下载完成的广播由 UpdateChecker 自己注册接收并处理 -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 两个精确闹钟权限并存是为覆盖 API 31~ 最新版本：
         USE_EXACT_ALARM 是 API 33+ 才有的安装即授予权限（面向闹钟/计时类应用），33+ 由它兜底；
         API 31/32 不认识它，靠 SCHEDULE_EXACT_ALARM + 启动时的授权引导（MainActivity）。
         两者缺一都会让对应版本区间排不了精确闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
        <!-- 用于弹出系统的「允许后台运行」对话框（ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS）。
             刻意不声明 ACCESS_NOTIFICATION_POLICY：2026-09-18 实测即使它 granted=true，
             渠道的 mBypassDnd 仍是 false，对 setBypassDnd 没有任何帮助；
             夜间也不该绕开用户自己开的系统免打扰 —— 该需求由应用内置的免打扰时段覆盖 -->
        <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
        <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- allowBackup 保持开启：饮水记录随系统备份/换机迁移有价值；本应用无账号体系，
         备份内容不含凭据类敏感数据 -->
    <application
        android:name=".WaterReminderApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="喝水提醒"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WaterReminder">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WaterReminder"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".notification.AlarmReceiver"
            android:exported="false" />

        <!-- 快捷记录入口：提醒通知与桌面小部件的「+200/350/500」按钮都发到这里。
             exported=false：只接受应用内显式广播，第三方无法伪造触发 -->
        <receiver
            android:name=".notification.QuickAddReceiver"
            android:exported="false" />

        <!-- 4x2 桌面小部件：进度 + 快捷记录。APPWIDGET_UPDATE 是系统受保护广播，
             exported=false 即可接收系统投递，第三方无法伪造 -->
        <receiver
            android:name=".widget.WaterWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_water_info" />
        </receiver>

        <!-- exported=true 是安全的：BOOT_COMPLETED / MY_PACKAGE_REPLACED 是系统受保护广播，
             只能由系统发出，第三方无法伪造触发。覆盖安装（含应用内更新）会清掉进程与闹钟，
             靠这里补排（restoreAlarmIfNeeded） -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>